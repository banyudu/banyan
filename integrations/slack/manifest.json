{
  "display_information": {
    "name": "Banyan Native Codex",
    "description": "Continue opted-in Banyan native Codex sessions in Slack threads",
    "background_color": "#33413a"
  },
  "features": {
    "bot_user": { "display_name": "Banyan", "always_online": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "channels:history", "groups:history", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "interactivity": { "is_enabled": true },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
