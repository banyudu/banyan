{
  "display_information": {
    "name": "Banyan",
    "description": "Supervise existing Banyan sessions in Slack",
    "background_color": "#33413a"
  },
  "features": {
    "bot_user": {
      "display_name": "Banyan",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
